        <mxCell id="sub" parent="1" style="text;html=1;align=left;fontSize=13;fontStyle=2;fontColor=#888888;" value="detail for each node:  Monitor.drawio  ·  Enforcer.drawio" vertex="1">
          <mxGeometry height="22" width="700" x="60" y="62" as="geometry" />
        </mxCell>
        <mxCell id="tDay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfaf2;strokeColor=#999999;dashed=1;align=center;fontSize=12;verticalAlign=middle;" value="&lt;b&gt;/daytime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#777777&quot; style=&quot;font-size:11px&quot;&gt;from outside · the current time&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="280" x="1020" y="120" as="geometry" />
        </mxCell>
        <mxCell id="mon" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#555555;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontSize=13;" value="&lt;b&gt;NodeStateMonitor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:11px&quot;&gt;what is happening?&lt;/font&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Learns each node&#39;s state when it&lt;br&gt;first appears, then only when it changes.&lt;br&gt;&lt;br&gt;Notices when a node leaves, and&lt;br&gt;checks every minute that the ones&lt;br&gt;still there can answer.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;Holds no threshold. No Domain layer.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="290" x="80" y="230" as="geometry" />
        </mxCell>
        <mxCell id="enf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f5fb;strokeColor=#555555;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontSize=13;" value="&lt;b&gt;NodeStateEnforcer&lt;/b&gt;&lt;hr&gt;Inputs and replies trigger a pass.&lt;br&gt;Compare target against observations;&lt;br&gt;send one async step per node.&lt;br&gt;&lt;br&gt;One pending request per node; global cap.&lt;br&gt;Communication + decision worker.&lt;br&gt;Bounded handoffs; no service wait." vertex="1">
          <mxGeometry height="250" width="320" x="1020" y="230" as="geometry" />
        </mxCell>
        <mxCell id="tCur" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfaf2;strokeColor=#555555;align=center;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;/nodes_current_states&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px&quot;&gt;one changed node,&lt;br&gt;straight away&lt;br&gt;&lt;br&gt;the whole table,&lt;br&gt;on a timer&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="220" x="510" y="290" as="geometry" />
        </mxCell>
        <mxCell id="tRdy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfaf2;strokeColor=#555555;align=center;fontSize=12;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;/system_readiness_status&lt;/b&gt;&lt;hr&gt;When the report changes&lt;br&gt;+ independent periodic heartbeat" vertex="1">
          <mxGeometry height="90" width="240" x="1450" y="290" as="geometry" />
        </mxCell>
        <mxCell id="managed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=center;fontSize=13;verticalAlign=middle;" value="&lt;b&gt;Managed lifecycle nodes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:11px&quot;&gt;100+ · outside this subdomain&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="520" x="490" y="620" as="geometry" />
        </mxCell>
        <mxCell id="loopNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#dddddd;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#666666;" value="&lt;b&gt;The feedback loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nothing plans ahead. Every pass reads what is&lt;br&gt;actually true and takes one step — which is why&lt;br&gt;a crash, a lost message or a manual change all&lt;br&gt;heal without any recovery code.&lt;/font&gt;" vertex="1">
